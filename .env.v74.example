# Copy this file to a private .env.v74 on the server; NEVER commit secrets.
# Use a long random secret for the runtime HMAC. For real deployment, prefer
# Docker/Kubernetes secrets or a cloud secret manager instead of a .env file.
XD_POSTGRES_PASSWORD=REPLACE_WITH_LONG_PRIVATE_PASSWORD
AGENT_RUNTIME_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AGENT_QUEUE_MAX=100
AGENT_MONTHLY_RESERVE_USD=10
AGENT_WORKER_CONCURRENCY=4
XD_STREAMLIT_SECRETS_FILE=/path/outside/repository/to/streamlit_secrets.toml
XD_WEB_BIND=127.0.0.1
# Same Google Drive/OAuth config already used by the verified V7.0 Streamlit.
XD_AUTH_COOKIE_SECRET=REPLACE_WITH_EXISTING_PRIVATE_COOKIE_SECRET
XD_OWNER_EMAIL=REPLACE_WITH_VERIFIED_OWNER_EMAIL
XD_DRIVE_ROOT_FOLDER_ID=REPLACE_WITH_PRIVATE_ROOT_FOLDER_ID
XD_DRIVE_CLIENT_ID=REPLACE_WITH_PRIVATE_OAUTH_CLIENT_ID
XD_DRIVE_CLIENT_SECRET=REPLACE_WITH_PRIVATE_OAUTH_SECRET
XD_DRIVE_REFRESH_TOKEN=REPLACE_WITH_PRIVATE_REFRESH_TOKEN
# Optional worker-only adapters (do not enable unless you accept data transfer).
AGENT_RUNTIME_OPTIONAL_PROVIDER=
AGENT_RUNTIME_OPTIONAL_MODEL=
AGENT_RUNTIME_ANTHROPIC_KEY=
AGENT_RUNTIME_OLLAMA_URL=http://127.0.0.1:11434
