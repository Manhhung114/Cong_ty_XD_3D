# Set a strong password and bootstrap the first administrator once.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_UNIQUE_PASSWORD
# SQLite is for local trial only; production should use PostgreSQL:
DATABASE_URL=sqlite:///./storage/company.sqlite3
DOCUMENT_STORAGE_DIR=./storage/documents
# Do not put real customer data on public GitHub/Pages.
OPENAI_API_KEY=
GEMINI_API_KEY=
